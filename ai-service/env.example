# Sao chep thanh .env va chinh gia tri neu can
AI_LOG_LEVEL=INFO
AI_MAX_IMAGE_MB=10
AI_REQUEST_TIMEOUT_S=20
AI_MAX_CONCURRENT_JOBS=2
AI_OCR_MIN_CONFIDENCE=0.5
AI_DETECTOR_MIN_CONFIDENCE=0.35
AI_PRELOAD_MODELS=true
# Bat che do doc anh theo duong dan (de trong = tat):
# AI_IMAGE_BASE_DIR=/data/images
# --- OCR engine (task 5.6) ---
# rapidocr (mac dinh) | paddle (can: pip install -r requirements-paddle.txt)
# AI_OCR_ENGINE=paddle
# PaddleOCR tren CPU cham (do duoc 10-22 giay/anh 640x200): tang timeout khi dung paddle
# AI_REQUEST_TIMEOUT_S=120
# AI_PADDLE_LANG=en
# AI_PADDLE_DEVICE=cpu
# --- Tra cuu dia diem (Nominatim/OpenStreetMap, mien phi) ---
# Chinh sach Nominatim cong cong: <= 1 yeu cau/giay, User-Agent dinh danh (kem lien he), phai cache,
# KHONG gui du lieu ca nhan/mat. Doc lai: https://operations.osmfoundation.org/policies/nominatim/
# AI_GEOCODER_ENABLED=true
# AI_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# AI_GEOCODER_USER_AGENT=DeathManagement-AI-Service/1.0 (lien-he: email-hoac-url-cua-nhom)
# AI_GEOCODER_TIMEOUT_S=5
# AI_GEOCODER_MIN_INTERVAL_S=1
# AI_GEOCODER_MAX_ATTEMPTS=3
# AI_GEOCODER_CACHE_TTL_S=86400
